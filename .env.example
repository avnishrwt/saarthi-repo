# Copy to .env and fill in. NEVER commit .env.
GEMINI_API_KEY=
# RAHAT_LLM=gemini              # gemini | anthropic | rules  (auto: gemini if GEMINI_API_KEY is set)
# RAHAT_LLM_MODEL=gemini-3.1-flash-lite   # default; gemini-3.6-flash is also correct but ~10 s/message
# ANTHROPIC_API_KEY=            # optional, for the 2-3 LLM comparison
RAHAT_SALT=pick-a-random-string-at-the-event
# RAHAT_EMBEDDINGS=hash          # hash | st (pip install sentence-transformers)
# RAHAT_STT=none                 # none | faster_whisper (pip install faster-whisper)
# RAHAT_COST_MODE=weighted       # weighted | prd

# WhatsApp Cloud API (Meta) - real messages from phones. See README "Live WhatsApp demo".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=rahat-verify-change-me
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0
